# Beam Chat — environment variables template.
# Copy to `.env` for local development and fill in real values.
# Never commit `.env`; it is gitignored.

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beam_chat_dev

# --- Phoenix server ---
PHX_SERVER=true
PHX_HOST=localhost
SECRET_KEY_BASE=change_me_run_mix_phx_gen_secret
PORT=4000

# --- Mail (magic links) ---
# Leave blank in dev to use the local mailbox at /dev/mailbox
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- OAuth (Assent) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SSO (HS256 JWT exchange at /api/sso/exchange) ---
SSO_JWT_SECRET=change_me_min_32_chars_shared_with_issuer
# Optional: comma-separated accepted secrets (current first, then previous)
# for zero-downtime rotation. When unset, only SSO_JWT_SECRET is accepted.
#SSO_JWT_SECRETS=change_me_min_32_chars_current,change_me_min_32_chars_previous

# --- Paystack (top-ups) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- M-Pesa Daraja (STK push) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# MPESA_STK_CALLBACK_URL **must** include the callback secret in the path:
#   https://your-host/webhooks/mpesa/<MPESA_CALLBACK_SECRET>
# The webhook rejects requests that don't match the configured secret. In prod,
# leaving MPESA_CALLBACK_SECRET empty **fails closed** (403).
MPESA_STK_CALLBACK_URL=
MPESA_CALLBACK_SECRET=

# --- LiveKit (audio/video) ---
# Local dev: the values below match the livekit/livekit-server `--dev` defaults
# and the docker-compose.yml `livekit` service. Override in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Public URL the browser will use (wss:// in production behind Traefik).
# In dev this typically matches LIVEKIT_URL.
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- Clustering ---
DNS_CLUSTER_QUERY=tasks.beam_chat_app

# --- Oban (job queues) ---
# Optional: override queue concurrency at boot, e.g. "default:20,payments:10".
# Unset/empty keeps the config.exs defaults. Unknown queue names fail startup.
#OBAN_QUEUES=default:20,payments:10

<div class="mx-auto w-full max-w-md pt-6">
  <div class="rounded-lg border border-slate-200 bg-white p-6 sm:p-8 shadow-civic-2">
    <h1 class="font-display text-headline-lg text-slate-900">Create account</h1>

    <p class="mt-1 text-body-md text-slate-600 mb-6">
      Choose a username and a strong password.
    </p>

    <%= if @error_message do %>
      <p class="alert alert-error rounded-md text-sm mb-4" role="alert">{@error_message}</p>
    <% end %>

    <.form :let={f} for={@changeset} action={~p"/auth/register"} method="post" class="space-y-4">
      <.input field={f[:username]} type="text" label="Username" required autocomplete="username" />
      <.input field={f[:email]} type="email" label="Email" required autocomplete="email" />
      <.input
        field={f[:password]}
        type="password"
        label="Password"
        required
        autocomplete="new-password"
      /> <button type="submit" class="btn btn-primary w-full rounded-md">Create account</button>
    </.form>

    <p class="mt-6 text-body-md text-center text-slate-600">
      <a class="link link-hover link-primary" href={~p"/auth/login"}>Already have an account?</a>
    </p>
  </div>
</div>

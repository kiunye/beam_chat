<div class="mx-auto w-full max-w-md pt-6">
  <div class="rounded-lg border border-slate-200 bg-white p-6 sm:p-8 shadow-civic-2">
    <h1 class="font-display text-headline-lg text-slate-900">Sign in</h1>

    <p class="mt-1 text-body-md text-slate-600 mb-6">
      Welcome back — sign in with your email or a provider below.
    </p>

    <%= if @error_message do %>
      <p class="alert alert-error rounded-md text-sm mb-4" role="alert">{@error_message}</p>
    <% end %>

    <form action={~p"/auth/login"} method="post" class="space-y-4">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <div class="fieldset">
        <label class="label" for="user_email">
          <span class="label-text text-body-md text-slate-700">Email</span>
        </label>
        <input
          class="input input-bordered w-full rounded-md"
          type="email"
          name="user[email]"
          id="user_email"
          autocomplete="email"
          required
        />
      </div>

      <div class="fieldset">
        <label class="label" for="user_password">
          <span class="label-text text-body-md text-slate-700">Password</span>
        </label>
        <input
          class="input input-bordered w-full rounded-md"
          type="password"
          name="user[password]"
          id="user_password"
          autocomplete="current-password"
          required
        />
      </div>
      <button type="submit" class="btn btn-primary w-full rounded-md">Sign in</button>
    </form>

    <div class="divider text-xs text-slate-400" aria-hidden="true">or continue with</div>

    <div class="grid grid-cols-2 gap-2">
      <a
        href={~p"/auth/oauth/google"}
        class="btn btn-outline btn-sm rounded-md border-slate-300 bg-white"
      >
        Google
      </a>
      <a
        href={~p"/auth/oauth/github"}
        class="btn btn-outline btn-sm rounded-md border-slate-300 bg-white"
      >
        GitHub
      </a>
    </div>

    <p class="mt-6 text-body-md text-center text-slate-600">
      <a class="link link-hover link-primary" href={~p"/auth/register"}>Create an account</a>
      <span class="mx-2 text-slate-300" aria-hidden="true">·</span>
      <a class="link link-hover link-primary" href={~p"/auth/magic-link"}>Email me a link</a>
    </p>
  </div>
</div>

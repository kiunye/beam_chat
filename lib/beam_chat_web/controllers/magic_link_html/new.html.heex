<div class="mx-auto w-full max-w-md pt-6">
  <div class="rounded-lg border border-slate-200 bg-white p-6 sm:p-8 shadow-civic-2">
    <h1 class="font-display text-headline-lg text-slate-900">Magic link</h1>

    <p class="mt-1 text-body-md text-slate-600 mb-6">
      If the address matches an account, we will email a one-time sign-in link (valid 15 minutes).
    </p>

    <%= if @error_message do %>
      <p class="alert alert-error rounded-md text-sm mb-4" role="alert">{@error_message}</p>
    <% end %>

    <form action={~p"/auth/magic-link"} method="post" class="space-y-4">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <div class="fieldset">
        <label class="label" for="user_email">
          <span class="label-text text-body-md text-slate-700">Email</span>
        </label>
        <input
          class="input input-bordered w-full rounded-md"
          type="email"
          name="user[email]"
          id="user_email"
          autocomplete="email"
          required
        />
      </div>
      <button type="submit" class="btn btn-primary w-full rounded-md">Send link</button>
    </form>

    <p class="mt-6 text-body-md text-center text-slate-600">
      <a class="link link-hover link-primary" href={~p"/auth/login"}>Back to sign in</a>
      <span class="mx-2 text-slate-300" aria-hidden="true">·</span>
      <a class="link link-hover link-primary" href={~p"/auth/register"}>Create an account</a>
    </p>
  </div>
</div>

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="min-h-dvh flex flex-col bg-base-100 text-base-content font-sans antialiased">
  <!-- Sidebar Rail - Dark Navigation -->
  <aside class="sidebar-rail hidden lg:block">
    <div class="flex flex-col h-full overflow-y-auto">
      <!-- Logo / Brand Header -->
      <div class="p-4 border-b border-base-300">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-box bg-primary text-primary-content flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 2L15.09 8.26l6.41 1.88c.94.28 1.37 1.16 1.11 2.11l-2.2 9.16c-.29 1.24-1.13 2.18-2.35 2.29L12 18c-2.21 0-4.07-1.27-4.87-3.23L4.88 12c-1.24-.29-2.18-1.13-2.29-2.35L1 12c0-1.7 1.3-3.1 3-3.1v-.09c0 .58 2.4 4.63 7.5 8.43 5.1-3.8 7.5-7.83 7.5-8.42V9c0-1.1-.9-2-2-2H5"
              />
            </svg>
          </div>
          <span class="font-display font-bold text-xl text-base-content">Beam Chat</span>
        </div>
      </div>
      
<!-- Navigation Links -->
      <nav class="flex-1 p-2">
        <ul class="space-y-1">
          <li>
            <.link
              navigate={~p"/"}
              class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-base-content hover:bg-base-200 hover:text-base-content"
            >
              <.icon name="hero-home" class="w-5 h-5" />
              <span>Home</span>
            </.link>
          </li>
          <%= if assigns[:current_user] do %>
            <li>
              <.link
                navigate={~p"/rooms"}
                class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-base-content hover:bg-base-200 hover:text-base-content"
              >
                <.icon name="hero-squares-2x2" class="w-5 h-5" />
                <span>Rooms</span>
              </.link>
            </li>
            <li>
              <.link
                navigate={~p"/messages"}
                class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-base-content hover:bg-base-200 hover:text-base-content"
              >
                <.icon name="hero-chat-globe" class="w-5 h-5" />
                <span>Messages</span>
              </.link>
            </li>
            <li>
              <.link
                navigate={~p"/wallet"}
                class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-base-content hover:bg-base-200 hover:text-base-content"
              >
                <.icon name="hero-wallet" class="w-5 h-5" />
                <span>Wallet</span>
              </.link>
            </li>
          <% end %>
        </ul>
      </nav>
      
<!-- User Menu / Auth -->
      <div class="border-t border-base-300 p-3">
        <%= if assigns[:current_user] do %>
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-full bg-base-200 flex items-center justify-center">
              <span class="text-xs text-base-content">
                {String.slice(assigns[:current_user].username || "U", 0, 1)}
              </span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-base-content truncate">
                {assigns[:current_user].username || "User"}
              </p>
            </div>
          </div>
          <form action={~p"/auth/logout"} method="post" class="inline">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit" class="btn btn-ghost btn-sm w-full">Sign out</button>
          </form>
        <% else %>
          <div class="flex flex-col gap-2">
            <a href={~p"/auth/login"} class="btn btn-ghost btn-sm w-full">Sign in</a>
            <a href={~p"/auth/register"} class="btn btn-primary btn-sm w-full">Create account</a>
          </div>
        <% end %>
      </div>
      
<!-- Theme Toggle -->
      <div class="border-t border-base-300 p-3">
        <Layouts.theme_toggle />
      </div>
    </div>
  </aside>
  
<!-- Main Content -->
  <main id="main-content" class="flex-1 w-full outline-none" tabindex="-1">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      {@inner_content}
    </div>
  </main>

  <footer class="border-t border-base-300/80 py-6 px-4 sm:px-6 lg:px-8 mt-auto">
    <div class="mx-auto max-w-6xl flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between text-sm text-base-content/60">
      <p>© {Date.utc_today().year} Beam Chat</p>

      <p class="text-xs sm:text-sm">Built with Phoenix &amp; LiveView</p>
    </div>
  </footer>

  <Layouts.flash_group flash={@flash} />
</div>

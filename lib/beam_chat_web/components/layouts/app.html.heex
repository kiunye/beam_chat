<a href="#main-content" class="skip-link">Skip to main content</a>
<div class="min-h-dvh flex flex-col bg-base-100 text-base-content font-sans antialiased">
  <header class="navbar border-b border-base-300/80 bg-base-100/90 backdrop-blur-md px-4 sm:px-6 lg:px-8 sticky top-0 z-40 min-h-14">
    <div class="navbar-start flex-1 gap-3">
      <a href={~p"/"} class="flex w-fit items-center gap-3 group">
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-content font-display font-bold text-sm shadow-sm ring-1 ring-base-300/50 group-hover:ring-primary/40 motion-safe:transition-shadow motion-safe:duration-200"
          aria-hidden="true"
        >
          B
        </span>
        <span class="flex flex-col leading-tight min-w-0">
          <span class="font-display font-semibold text-base tracking-tight">Beam Chat</span>
          <span class="text-xs text-base-content/60 font-normal hidden sm:block">
            Rooms, DMs, live presence
          </span>
        </span>
      </a>
    </div>
    <div class="navbar-end flex-none">
      <div class="flex flex-wrap items-center justify-end gap-1 sm:gap-2">
        <a href={~p"/"} class="btn btn-ghost btn-sm hidden sm:inline-flex">Home</a>
        <%= if assigns[:current_user] do %>
          <.link navigate={~p"/rooms"} class="btn btn-ghost btn-sm hidden sm:inline-flex">
            Rooms
          </.link>
          <.link navigate={~p"/messages"} class="btn btn-ghost btn-sm hidden sm:inline-flex">
            Messages
          </.link>
          <.link navigate={~p"/wallet"} class="btn btn-ghost btn-sm hidden sm:inline-flex">
            Wallet
          </.link>
          <span
            class="hidden md:inline text-sm text-base-content/70 max-w-[12rem] truncate px-2"
            title={@current_user.email}
          >
            {@current_user.username}
          </span>
          <form action={~p"/auth/logout"} method="post" class="inline">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
          </form>
        <% else %>
          <a href={~p"/auth/login"} class="btn btn-ghost btn-sm">Sign in</a>
          <a href={~p"/auth/register"} class="btn btn-primary btn-sm">Create account</a>
        <% end %>
        <Layouts.theme_toggle />
      </div>
    </div>
  </header>

  <main id="main-content" class="flex-1 w-full outline-none" tabindex="-1">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      {@inner_content}
    </div>
  </main>

  <footer class="border-t border-base-300/80 py-6 px-4 sm:px-6 lg:px-8 mt-auto">
    <div class="mx-auto max-w-6xl flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between text-sm text-base-content/60">
      <p>© {Date.utc_today().year} Beam Chat</p>
      <p class="text-xs sm:text-sm">Built with Phoenix &amp; LiveView</p>
    </div>
  </footer>

  <Layouts.flash_group flash={@flash} />
</div>

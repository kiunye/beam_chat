<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content="BeamChat — rooms, direct messages, wallet, and live radio, all in real time."
    />
    <meta property="og:title" content={assigns[:page_title] || "BeamChat"} />
    <meta
      property="og:description"
      content="BeamChat — rooms, direct messages, wallet, and live radio, all in real time."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico"} />
    <.live_title default="BeamChat">{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>

  <body class="min-h-dvh font-sans">{@inner_content}</body>
</html>

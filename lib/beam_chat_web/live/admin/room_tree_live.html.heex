<div class="space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-display text-2xl font-semibold tracking-tight text-base-content">
        Room Tree
      </h1>

      <p class="mt-1 text-sm text-base-content/70">
        Browse the hierarchical rooms for a county. Admins see the full tree and can create sub-rooms.
      </p>
    </div>

    <.form
      for={@tenant_form}
      phx-change="tenant-selected"
      id="tenant-switcher-form"
      class="flex flex-col gap-2 sm:items-end"
    >
      <.input
        field={@tenant_form[:tenant_id]}
        type="select"
        label="Active county / tenant"
        options={Enum.map(@tenants, fn t -> {t.name, t.id} end)}
      />
    </.form>
  </div>

  <div
    :if={is_nil(@tenant)}
    class="rounded-box border border-base-300 bg-base-200/40 p-8 text-center"
  >
    <p class="font-medium text-base-content/80">You are not a member of any tenant yet.</p>
    <p class="mt-2 text-sm text-base-content/60">Ask a county administrator to add you.</p>
  </div>

  <div :if={not is_nil(@tenant)} class="space-y-4">
    <div class="flex items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2 text-sm text-base-content/70">
        <span class="font-medium text-base-content">{@tenant.name}</span>
        <span :if={@is_admin} class="badge badge-success badge-sm">Admin</span>
        <span :if={not @is_admin} class="badge badge-ghost badge-sm">Member (visible only)</span>
      </div>

      <.button
        :if={@is_admin}
        phx-click="toggle-create"
        class={["btn btn-sm", @show_create && "btn-primary", not @show_create && "btn-outline"]}
        id="toggle-create-room"
      >
        {if @show_create, do: "Close", else: "New room"}
      </.button>
    </div>

    <.form
      :if={@is_admin and @show_create}
      for={@form}
      id="room-create-form"
      phx-change="validate"
      phx-submit="save"
      class="space-y-3 rounded-box border border-base-300 bg-base-100 p-4 shadow-sm"
    >
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <.input
            field={@form[:name]}
            type="text"
            label="Name"
            placeholder="Subcounty A"
            required
          />
        </div>
        <div>
          <.input
            field={@form[:slug]}
            type="text"
            label="Slug"
            placeholder="subcounty-a"
            required
          />
        </div>
      </div>

      <.input
        field={@form[:description]}
        type="textarea"
        label="Description"
        placeholder="Optional description"
      />

      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <.input
            field={@form[:type]}
            type="select"
            label="Type"
            options={[
              {"Public", "public"},
              {"Private", "private"},
              {"Secret", "secret"},
              {"Paid", "paid"}
            ]}
          />
        </div>
        <div>
          <.input
            field={@form[:parent_id]}
            type="select"
            label="Parent room"
            prompt="None (top-level)"
            options={parent_options(@tree)}
          />
        </div>
      </div>

      <div class="flex justify-end gap-2">
        <.button phx-click="toggle-create" class="btn btn-ghost btn-sm" type="button">
          Cancel
        </.button>
        <.button type="submit" class="btn btn-primary btn-sm">Create room</.button>
      </div>
    </.form>

    <div
      :if={@tree == []}
      class="rounded-box border border-base-300 bg-base-200/40 p-8 text-center"
    >
      <p class="font-medium text-base-content/80">
        {if @is_admin,
          do: "No rooms yet — create the first one above.",
          else: "No rooms are visible to you in this tenant."}
      </p>
    </div>

    <div :if={@tree != []} id="room-tree" class="space-y-2">
      <.room_node :for={node <- @tree} node={node} is_admin={@is_admin} />
    </div>
  </div>
</div>

#!/bin/sh
# Release environment overrides — sourced by /app/bin/beam_chat for every
# command (start, eval, rpc, ...). See `mix help release` and
# https://hexdocs.pm/mix/Mix.Tasks.Release.html#module-customization.
#
# This is the contract for the Swarm deployment: docker-compose.swarm.yml
# must NOT pass a fixed RELEASE_NODE to the app replicas — it is derived
# here at boot so every replica gets a unique Erlang node name.

# Distributed Erlang with long names ("name" distribution). Required for
# any future dns_cluster/libcluster-based node discovery.
export RELEASE_DISTRIBUTION=name

# Docker sets HOSTNAME to the container/task ID, which is unique per Swarm
# replica. Fall back to a literal so local `mix release` runs without
# HOSTNAME still produce a valid node name.
export RELEASE_NODE="beam_chat@${HOSTNAME:-beam_chat}"

# The Erlang cookie is supplied via the environment (RELEASE_COOKIE in the
# Swarm service env / host .env). Only export it when set so local releases
# without a cookie keep working. All replicas in a cluster MUST share the
# same cookie value.
if [ -n "${RELEASE_COOKIE:-}" ]; then
  export RELEASE_COOKIE
fi

# PHX_SERVER is deliberately NOT set here: the Dockerfile ENV enables the
# web server, and local release runs opt in explicitly.
